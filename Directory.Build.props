<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591;NU1701</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>

    <!-- The one place the version lives. build\publish.ps1 reads it, the release tag is v$(Version),
         and every exe carries it in its file properties. -->
    <Version>2.3.0</Version>
    <Product>TIA Openness Studio</Product>
  </PropertyGroup>

  <!--
    Which Openness layout lib\ holds. V21 and later ship several assemblies anchored by
    Siemens.Engineering.Base.dll; V15.1 - V20 ship the single Siemens.Engineering.dll.
    Either one enables the Openness adapter; neither builds it and the bridge says so.
  -->
  <PropertyGroup>
    <OpennessLibDir>$(RepoRoot)lib\</OpennessLibDir>
    <OpennessMonolithicLib>$(OpennessLibDir)Siemens.Engineering.dll</OpennessMonolithicLib>
    <OpennessModularLib>$(OpennessLibDir)Siemens.Engineering.Base.dll</OpennessModularLib>

    <HasOpennessLib>false</HasOpennessLib>
    <HasOpennessLib Condition="Exists('$(OpennessMonolithicLib)') Or Exists('$(OpennessModularLib)')">true</HasOpennessLib>
    <OpennessIsModular Condition="Exists('$(OpennessModularLib)')">true</OpennessIsModular>
  </PropertyGroup>
</Project>
