<!--
  Buttons.

  macOS has three button shapes that matter here and they are not interchangeable:
    - the push button, used in forms and dialogs: a bordered capsuleish rectangle with a very
      light fill, and a filled blue variant for the default action;
    - the toolbar button, which has no chrome at all until the pointer is over it;
    - the destructive button, which is red text on a normal push button rather than a red fill -
      macOS reserves a red *fill* for the one irreversible action in a sheet.
  Mixing them is what makes a Windows app styled "Apple-ish" still read as a Windows app.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ux="clr-namespace:TiaOpenness.Gui.Controls">

  <!-- The shared innards: optional leading glyph, then the label. -->
  <ControlTemplate x:Key="Mac.ButtonTemplate" TargetType="ButtonBase">
    <!-- Attached properties are read with TemplateBinding and plain Triggers rather than
         Binding paths: "(ux:Ux.Icon)" inside a Binding relies on the path parser resolving the
         XML prefix at evaluation time, and when that fails it fails silently to null - every
         glyph collapses and nothing is logged. TemplateBinding resolves the property at parse
         time, so a mistake here is a load error instead. -->
    <Border x:Name="Chrome"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding ux:Ux.CornerRadius}"
            SnapsToDevicePixels="True">
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Margin="{TemplateBinding Padding}">
        <Path x:Name="Glyph"
              Style="{DynamicResource Mac.Icon}"
              Data="{TemplateBinding ux:Ux.Icon}"
              Margin="0,0,6,0" />
        <ContentPresenter x:Name="Label"
                          VerticalAlignment="Center"
                          RecognizesAccessKey="True"
                          SnapsToDevicePixels="True" />
      </StackPanel>
    </Border>

    <ControlTemplate.Triggers>
      <!-- Most buttons carry no glyph, so the Path has to disappear rather than reserve space. -->
      <Trigger Property="ux:Ux.Icon" Value="{x:Null}">
        <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <!-- An icon-only button should not carry the label's right margin. -->
      <Trigger Property="Content" Value="{x:Null}">
        <Setter TargetName="Glyph" Property="Margin" Value="0" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.4" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <!-- ===================== push button (the app-wide default) ===================== -->
  <Style x:Key="Mac.Button" TargetType="Button">
    <Setter Property="Template" Value="{StaticResource Mac.ButtonTemplate}" />
    <Setter Property="FontFamily" Value="{DynamicResource Mac.Font}" />
    <Setter Property="FontSize" Value="{DynamicResource Mac.FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Mac.Label}" />
    <Setter Property="Background" Value="{DynamicResource Mac.ControlBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Mac.ControlBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="11,3" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="MinWidth" Value="68" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="Cursor" Value="Arrow" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="ux:Ux.CornerRadius" Value="6" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Mac.ControlHover}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Mac.ControlPressed}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="{DynamicResource Mac.ControlDisabled}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="Button" BasedOn="{StaticResource Mac.Button}" />

  <!-- ===================== default / primary action ===================== -->
  <Style x:Key="Mac.Button.Primary" TargetType="Button" BasedOn="{StaticResource Mac.Button}">
    <Setter Property="Background" Value="{DynamicResource Mac.Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Mac.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Mac.OnAccent}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Mac.AccentHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Mac.AccentHover}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Mac.AccentPressed}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Mac.AccentPressed}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="{DynamicResource Mac.ControlDisabled}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Mac.ControlBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Mac.TertiaryLabel}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===================== destructive ===================== -->
  <Style x:Key="Mac.Button.Destructive" TargetType="Button" BasedOn="{StaticResource Mac.Button}">
    <Setter Property="Foreground" Value="{DynamicResource Mac.Red}" />
  </Style>

  <!-- ===================== toolbar ===================== -->
  <!-- No border, no fill, until hovered. The icon carries the meaning; the label confirms it. -->
  <Style x:Key="Mac.Button.Toolbar" TargetType="Button" BasedOn="{StaticResource Mac.Button}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Margin" Value="0,0,2,0" />
    <Setter Property="Foreground" Value="{DynamicResource Mac.Label}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Mac.ControlHover}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Mac.ControlPressed}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="Transparent" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- A toolbar button whose action cannot be undone: red glyph and label, no red fill. -->
  <Style x:Key="Mac.Button.ToolbarDestructive" TargetType="Button" BasedOn="{StaticResource Mac.Button.Toolbar}">
    <Setter Property="Foreground" Value="{DynamicResource Mac.Red}" />
  </Style>

  <!-- ===================== bare icon ===================== -->
  <Style x:Key="Mac.Button.Icon" TargetType="Button" BasedOn="{StaticResource Mac.Button.Toolbar}">
    <Setter Property="Padding" Value="5" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Foreground" Value="{DynamicResource Mac.SecondaryLabel}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Mac.ControlHover}" />
        <Setter Property="Foreground" Value="{DynamicResource Mac.Label}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===================== segmented control ===================== -->
  <!-- Used for the language and appearance pickers, and for the main tab strip. A segment is a
       ToggleButton so the selected one stays lit; the group's exclusivity comes from the
       binding behind it rather than from RadioButton grouping, which does not survive
       being rebuilt by a template. -->
  <Style x:Key="Mac.Segment" TargetType="ToggleButton">
    <Setter Property="Template" Value="{StaticResource Mac.ButtonTemplate}" />
    <Setter Property="FontFamily" Value="{DynamicResource Mac.Font}" />
    <Setter Property="FontSize" Value="{DynamicResource Mac.FontSize.Small}" />
    <Setter Property="Foreground" Value="{DynamicResource Mac.Label}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="MinWidth" Value="34" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="ux:Ux.CornerRadius" Value="5" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource Mac.Label}" />
      </Trigger>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Background" Value="{DynamicResource Mac.SegmentThumb}" />
        <Setter Property="Foreground" Value="{DynamicResource Mac.Label}" />
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsChecked" Value="False" />
          <Condition Property="IsMouseOver" Value="False" />
        </MultiTrigger.Conditions>
        <Setter Property="Foreground" Value="{DynamicResource Mac.SecondaryLabel}" />
      </MultiTrigger>
    </Style.Triggers>
  </Style>

  <!-- The picker form of a segment. A ToggleButton can be clicked back off, which would leave a
       two-segment picker showing neither choice; a RadioButton refuses to deselect itself, which
       is exactly the behaviour a segmented picker needs. -->
  <Style x:Key="Mac.SegmentPick" TargetType="RadioButton" BasedOn="{StaticResource Mac.Segment}" />

  <!-- The track the segments sit in. -->
  <Style x:Key="Mac.SegmentBar" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Mac.SegmentTrack}" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

</ResourceDictionary>
