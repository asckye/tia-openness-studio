<!--
  Lists, tables and scrollers.

  Two macOS conventions drive the look:
    - selection is an inset rounded rectangle, not a full-bleed bar, and it goes grey when the
      list loses focus so the window never shows two "active" selections at once;
    - scrollers are overlay: a thin translucent thumb with no track, arrows or gutter, widening
      when the pointer is over it.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===================== scroller ===================== -->
  <Style x:Key="Mac.Scroller.Thumb" TargetType="Thumb">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border Background="{DynamicResource Mac.ScrollThumb}" CornerRadius="4" Margin="2" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The arrowless track macOS uses. RepeatButtons are kept but given no size, because
       ScrollBar's own logic still expects PART_Track to have them as siblings. -->
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="11" />
    <Setter Property="MinWidth" Value="11" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid x:Name="Root" Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" Width="0" Height="0" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{DynamicResource Mac.Scroller.Thumb}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" Width="0" Height="0" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>

          <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <!-- The size swap lives on the style, not in the template: a style trigger outranks a style
         setter, whereas the interaction between a template trigger and the Width setter above is
         the kind of precedence puzzle that only shows up as a mysteriously fat scrollbar. -->
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="11" />
        <Setter Property="MinHeight" Value="11" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ScrollViewer itself keeps its stock template. Retemplating it would also retemplate the
       one inside every TextBox (PART_ContentHost) and inside the DataGrid, for no gain: the
       macOS look here comes from the scroller above, not from the viewer around it. -->

  <!-- ===================== sidebar list ===================== -->
  <Style x:Key="Mac.ListBoxItem" TargetType="ListBoxItem">
    <Setter Property="FontFamily" Value="{DynamicResource Mac.Font}" />
    <Setter Property="FontSize" Value="{DynamicResource Mac.FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Mac.Label}" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Chrome" Background="Transparent" CornerRadius="6"
                  Padding="{TemplateBinding Padding}" Margin="0,1">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True" />
                <Condition Property="IsSelected" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Mac.ControlHover}" />
            </MultiTrigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Mac.SelectionFill}" />
              <Setter Property="Foreground" Value="{DynamicResource Mac.SelectionText}" />
              <Setter Property="TextElement.Foreground" Value="{DynamicResource Mac.SelectionText}" />
            </Trigger>
            <!-- Focus follows the window: an unfocused list shows a grey selection so only one
                 place on screen ever looks active. -->
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsSelected" Value="True" />
                <Condition Property="Selector.IsSelectionActive" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Mac.SelectionInactive}" />
              <Setter Property="Foreground" Value="{DynamicResource Mac.Label}" />
              <Setter Property="TextElement.Foreground" Value="{DynamicResource Mac.Label}" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ListBoxItem" BasedOn="{StaticResource Mac.ListBoxItem}" />

  <Style TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>

  <!-- ===================== table ===================== -->
  <Style x:Key="Mac.DataGridColumnHeader" TargetType="DataGridColumnHeader">
    <Setter Property="FontFamily" Value="{DynamicResource Mac.Font}" />
    <Setter Property="FontSize" Value="{DynamicResource Mac.FontSize.Caption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Mac.SecondaryLabel}" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="SeparatorBrush" Value="{DynamicResource Mac.HairLine}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridColumnHeader">
          <Grid>
            <Border x:Name="Chrome" Background="Transparent"
                    BorderBrush="{DynamicResource Mac.Separator}" BorderThickness="0,0,0,1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
            </Border>
            <!-- The column-resize grip macOS puts between headers. -->
            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="6"
                   Cursor="SizeWE" Opacity="0">
              <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                  <Border Background="Transparent" />
                </ControlTemplate>
              </Thumb.Template>
            </Thumb>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Mac.ControlHover}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource Mac.DataGridColumnHeader}" />

  <Style x:Key="Mac.DataGridCell" TargetType="DataGridCell">
    <Setter Property="Foreground" Value="{DynamicResource Mac.Label}" />
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <!-- Selection is painted by the row, so the cell must not paint it a second time. -->
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Mac.SelectionText}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="DataGridCell" BasedOn="{StaticResource Mac.DataGridCell}" />

  <Style x:Key="Mac.DataGridRow" TargetType="DataGridRow">
    <Setter Property="FontFamily" Value="{DynamicResource Mac.Font}" />
    <Setter Property="FontSize" Value="{DynamicResource Mac.FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Mac.Label}" />
    <!-- No Background setter: the DataGrid assigns RowBackground / AlternatingRowBackground to
         each row, and a style setter here would silently win over it. -->
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridRow">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <DataGridCellsPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True" />
                <Condition Property="IsSelected" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Mac.ControlHover}" />
            </MultiTrigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Mac.SelectionFill}" />
              <Setter Property="TextElement.Foreground" Value="{DynamicResource Mac.SelectionText}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsSelected" Value="True" />
                <Condition Property="Selector.IsSelectionActive" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Mac.SelectionInactive}" />
              <Setter Property="TextElement.Foreground" Value="{DynamicResource Mac.Label}" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="DataGridRow" BasedOn="{StaticResource Mac.DataGridRow}" />

  <Style TargetType="DataGrid">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="RowBackground" Value="Transparent" />
    <Setter Property="AlternatingRowBackground" Value="{DynamicResource Mac.RowAlternate}" />
    <Setter Property="GridLinesVisibility" Value="None" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="RowHeight" Value="27" />
    <Setter Property="ColumnHeaderHeight" Value="26" />
    <Setter Property="CanUserAddRows" Value="False" />
    <Setter Property="CanUserDeleteRows" Value="False" />
    <Setter Property="AutoGenerateColumns" Value="False" />
    <Setter Property="SelectionUnit" Value="FullRow" />
    <Setter Property="EnableRowVirtualization" Value="True" />
    <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
    <Setter Property="HorizontalGridLinesBrush" Value="Transparent" />
    <Setter Property="FontFamily" Value="{DynamicResource Mac.Font}" />
    <Setter Property="FontSize" Value="{DynamicResource Mac.FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Mac.Label}" />
  </Style>

</ResourceDictionary>
