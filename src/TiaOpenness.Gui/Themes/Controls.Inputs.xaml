<!--
  Text fields, checkboxes and pop-up buttons.

  The detail that does most of the work here is the focus ring: macOS draws a soft accent halo
  *outside* the field's border rather than thickening the border itself, so the field does not
  shift or grow when focused. That is why every field is two nested borders - an outer ring that
  is transparent until focus, and the field proper inside it.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ux="clr-namespace:TiaOpenness.Gui.Controls">

  <!-- ===================== text field ===================== -->
  <Style x:Key="Mac.TextBox" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{DynamicResource Mac.Font}" />
    <Setter Property="FontSize" Value="{DynamicResource Mac.FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Mac.Label}" />
    <Setter Property="Background" Value="{DynamicResource Mac.FieldBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Mac.FieldBorder}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Mac.Label}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Mac.Accent}" />
    <Setter Property="SelectionOpacity" Value="0.28" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="7,3" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <!-- The ring is drawn outside the field, so focus does not resize anything. -->
          <Border x:Name="Ring" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent"
                  Margin="-2" Padding="2">
            <Border x:Name="Field"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    SnapsToDevicePixels="True">
              <Grid>
                <TextBlock x:Name="Placeholder"
                           Text="{Binding Path=(ux:Ux.Placeholder), RelativeSource={RelativeSource TemplatedParent}}"
                           Foreground="{DynamicResource Mac.PlaceholderLabel}"
                           FontFamily="{DynamicResource Mac.Font}"
                           FontSize="{DynamicResource Mac.FontSize.Body}"
                           Margin="{TemplateBinding Padding}"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           TextTrimming="CharacterEllipsis"
                           Visibility="Collapsed" />
                <ScrollViewer x:Name="PART_ContentHost"
                              Margin="{TemplateBinding Padding}"
                              VerticalAlignment="Center"
                              Focusable="False"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Hidden" />
              </Grid>
            </Border>
          </Border>

          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Mac.Accent}" />
              <Setter TargetName="Ring" Property="Opacity" Value="0.45" />
              <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Mac.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Field" Property="Background" Value="{DynamicResource Mac.ControlDisabled}" />
              <Setter Property="Foreground" Value="{DynamicResource Mac.TertiaryLabel}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TextBox" BasedOn="{StaticResource Mac.TextBox}" />

  <!-- The log pane: a read-only monospace field with no chrome of its own. -->
  <Style x:Key="Mac.TextBox.Console" TargetType="TextBox" BasedOn="{StaticResource Mac.TextBox}">
    <Setter Property="FontFamily" Value="{DynamicResource Mac.FontMono}" />
    <Setter Property="FontSize" Value="{DynamicResource Mac.FontSize.Small}" />
    <Setter Property="Background" Value="{DynamicResource Mac.CodeBackground}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Mac.SecondaryLabel}" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border Background="{TemplateBinding Background}" CornerRadius="8" SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================== checkbox ===================== -->
  <Style x:Key="Mac.CheckBox" TargetType="CheckBox">
    <Setter Property="FontFamily" Value="{DynamicResource Mac.Font}" />
    <Setter Property="FontSize" Value="{DynamicResource Mac.FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Mac.Label}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="Box" Width="15" Height="15" CornerRadius="4"
                    Background="{DynamicResource Mac.FieldBackground}"
                    BorderBrush="{DynamicResource Mac.FieldBorder}"
                    BorderThickness="1"
                    VerticalAlignment="Center"
                    SnapsToDevicePixels="True">
              <Path x:Name="Tick"
                    Data="{DynamicResource Icon.Check}"
                    Stroke="{DynamicResource Mac.OnAccent}"
                    StrokeThickness="2"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    Stretch="Uniform" Margin="2.5" Opacity="0" />
            </Border>
            <ContentPresenter x:Name="Label" Margin="6,0,0,0" VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
          </StackPanel>

          <ControlTemplate.Triggers>
            <Trigger Property="Content" Value="{x:Null}">
              <Setter TargetName="Label" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource Mac.Accent}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Mac.Accent}" />
              <Setter TargetName="Tick" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Mac.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="CheckBox" BasedOn="{StaticResource Mac.CheckBox}" />

  <!-- ===================== pop-up button (ComboBox) ===================== -->
  <Style x:Key="Mac.ComboBoxItem" TargetType="ComboBoxItem">
    <Setter Property="FontFamily" Value="{DynamicResource Mac.Font}" />
    <Setter Property="FontSize" Value="{DynamicResource Mac.FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Mac.Label}" />
    <Setter Property="Padding" Value="9,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Chrome" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"
                  Margin="4,1" SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Mac.Accent}" />
              <Setter Property="Foreground" Value="{DynamicResource Mac.OnAccent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBoxItem" BasedOn="{StaticResource Mac.ComboBoxItem}" />

  <Style x:Key="Mac.ComboBox" TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{DynamicResource Mac.Font}" />
    <Setter Property="FontSize" Value="{DynamicResource Mac.FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Mac.Label}" />
    <Setter Property="Background" Value="{DynamicResource Mac.ControlBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Mac.ControlBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Chrome"
                          Background="{DynamicResource Mac.ControlBackground}"
                          BorderBrush="{DynamicResource Mac.ControlBorder}"
                          BorderThickness="1" CornerRadius="6" SnapsToDevicePixels="True">
                    <Path x:Name="Chevrons"
                          Data="{DynamicResource Icon.ChevronUpDown}"
                          Stroke="{DynamicResource Mac.SecondaryLabel}"
                          StrokeThickness="1.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="16" Height="16" Stretch="None"
                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Mac.ControlHover}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>

            <ContentPresenter x:Name="Selection"
                              Margin="8,0,26,0"
                              VerticalAlignment="Center"
                              IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />

            <TextBlock x:Name="Empty"
                       Text="{Binding Path=(ux:Ux.Placeholder), RelativeSource={RelativeSource TemplatedParent}}"
                       Foreground="{DynamicResource Mac.PlaceholderLabel}"
                       Margin="8,0,26,0" VerticalAlignment="Center"
                       IsHitTestVisible="False" Visibility="Collapsed" />

            <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4"
                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
              <Border Background="{DynamicResource Mac.CardBackground}"
                      BorderBrush="{DynamicResource Mac.Separator}"
                      BorderThickness="1" CornerRadius="7" Padding="0,4"
                      MinWidth="{Binding ActualWidth, ElementName=Toggle}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.20" Direction="270" />
                </Border.Effect>
                <ScrollViewer>
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>

          <ControlTemplate.Triggers>
            <Trigger Property="SelectionBoxItem" Value="{x:Null}">
              <Setter TargetName="Empty" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox" BasedOn="{StaticResource Mac.ComboBox}" />

</ResourceDictionary>
