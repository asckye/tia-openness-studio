<!--
  The window frame.

  WindowStyle=None replaces the Windows caption with our own, so everything the caption used to
  provide has to come back explicitly. WindowChrome is what supplies it: CaptionHeight makes the
  top strip behave like a real title bar (drag, double-click to zoom, Aero Snap, shake), and
  ResizeBorderThickness restores edge resizing. Any control that sits inside that strip must set
  WindowChrome.IsHitTestVisibleInChrome="True" or the chrome swallows its clicks.

  The traffic lights are drawn rather than imported: they take their fill from Background, go
  grey when the window is not key, and only reveal their glyphs while the pointer is anywhere
  over the group - which is why the glyph trigger watches the parent panel, not the button.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:ux="clr-namespace:TiaOpenness.Gui.Controls">

  <!-- macOS keeps these hues in both appearances; only the inactive state follows the theme. -->
  <SolidColorBrush x:Key="Mac.Light.Close" Color="#FF5F57" />
  <SolidColorBrush x:Key="Mac.Light.Minimize" Color="#FEBC2E" />
  <SolidColorBrush x:Key="Mac.Light.Zoom" Color="#28C840" />
  <SolidColorBrush x:Key="Mac.Light.Glyph" Color="#4A0000" Opacity="0.55" />

  <Style x:Key="Mac.TrafficLight" TargetType="Button">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Background="Transparent">
            <Ellipse x:Name="Dot" Fill="{TemplateBinding Background}" />
            <Path x:Name="Glyph"
                  Data="{TemplateBinding ux:Ux.Icon}"
                  Stroke="{StaticResource Mac.Light.Glyph}"
                  StrokeThickness="1.6"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  Fill="{StaticResource Mac.Light.Glyph}"
                  Stretch="Uniform" Width="7" Height="7"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Opacity="0" />
          </Grid>

          <ControlTemplate.Triggers>
            <!-- Hovering any one light lights up all three glyphs, as on macOS. -->
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type StackPanel}}}"
                         Value="True">
              <Setter TargetName="Glyph" Property="Opacity" Value="1" />
            </DataTrigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Dot" Property="Opacity" Value="0.7" />
            </Trigger>
            <!-- A window that is not key shows grey lights and no glyphs. -->
            <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                         Value="False">
              <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Mac.SelectionInactive}" />
              <Setter TargetName="Glyph" Property="Opacity" Value="0" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================== the window itself ===================== -->
  <Style x:Key="Mac.Window" TargetType="Window">
    <Setter Property="Background" Value="{DynamicResource Mac.WindowBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource Mac.Label}" />
    <Setter Property="FontFamily" Value="{DynamicResource Mac.Font}" />
    <Setter Property="FontSize" Value="{DynamicResource Mac.FontSize.Body}" />
    <Setter Property="WindowStyle" Value="None" />
    <Setter Property="ResizeMode" Value="CanResize" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="shell:WindowChrome.WindowChrome">
      <Setter.Value>
        <!-- CaptionHeight must match the title bar drawn in MainWindow.xaml. -->
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Window">
          <Border x:Name="WindowRoot"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{DynamicResource Mac.Separator}"
                  BorderThickness="1"
                  SnapsToDevicePixels="True">
            <!-- AdornerDecorator keeps validation adorners and drag visuals working once the
                 default window template is gone. -->
            <AdornerDecorator>
              <ContentPresenter />
            </AdornerDecorator>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="WindowState" Value="Maximized">
              <!-- A maximized borderless window has no edge to draw. -->
              <Setter TargetName="WindowRoot" Property="BorderThickness" Value="0" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
