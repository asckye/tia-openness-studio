<!--
  Toolbar glyphs, drawn on a 16x16 grid.

  SF Symbols cannot be shipped, so these are hand-cut outlines at roughly the same optical
  weight: every one is stroked rather than filled, at a single thickness with round caps, which
  is what makes a set of icons read as one family instead of as clip art. Keep new glyphs on the
  same grid and the same construction.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- waveform.path.ecg - environment check -->
  <PathGeometry x:Key="Icon.Doctor" Figures="M1,8 L4.2,8 L6,3.4 L9.2,12.6 L11,8 L15,8" />

  <!-- bolt - connect -->
  <PathGeometry x:Key="Icon.Connect" Figures="M9.2,1.2 L3.4,8.6 L7.4,8.6 L6.8,14.8 L12.6,7.4 L8.6,7.4 Z" />

  <!-- hammer - compile -->
  <PathGeometry x:Key="Icon.Compile" Figures="M1.8,14.2 L7.2,8.8 M6.2,6.6 L9.4,9.8 L13.4,6.4 L10.2,3.2 Z M8.8,4.6 L11,2.4" />

  <!-- magnifyingglass - inspect -->
  <PathGeometry x:Key="Icon.Inspect" Figures="M2.4,7 A4.6,4.6 0 1 0 11.6,7 A4.6,4.6 0 1 0 2.4,7 M10.4,10.4 L14.2,14.2" />

  <!-- tray.and.arrow.down - import -->
  <PathGeometry x:Key="Icon.Import" Figures="M8,1.8 L8,9.6 M5,6.8 L8,9.8 L11,6.8 M2,10.6 L2,13.6 L14,13.6 L14,10.6" />

  <!-- tray.and.arrow.up - export -->
  <PathGeometry x:Key="Icon.Export" Figures="M8,9.8 L8,2 M5,5 L8,2 L11,5 M2,10.6 L2,13.6 L14,13.6 L14,10.6" />

  <!-- internaldrive / floppy - save -->
  <PathGeometry x:Key="Icon.Save" Figures="M2.4,2.4 L10.4,2.4 L13.6,5.6 L13.6,13.6 L2.4,13.6 Z M5.2,2.4 L5.2,6.4 L10.4,6.4 L10.4,2.4 M4.8,9.6 L11.2,9.6 L11.2,13.6 L4.8,13.6 Z" />

  <!-- folder - browse -->
  <PathGeometry x:Key="Icon.Folder" Figures="M1.6,12.8 L1.6,3.2 L6.2,3.2 L7.6,5.2 L14.4,5.2 L14.4,12.8 Z" />

  <!-- arrow.clockwise - reload -->
  <PathGeometry x:Key="Icon.Reload" Figures="M11.8,4.2 A5.4,5.4 0 1 0 11.8,11.8 M12.6,1.6 L12.6,4.8 L9.4,4.8" />

  <!-- arrow.right.doc - push -->
  <PathGeometry x:Key="Icon.Push" Figures="M2.4,8 L12.6,8 M9.2,4.6 L12.6,8 L9.2,11.4" />

  <!-- arrow.left.doc - pull -->
  <PathGeometry x:Key="Icon.Pull" Figures="M13.6,8 L3.4,8 M6.8,4.6 L3.4,8 L6.8,11.4" />

  <!-- point.3.connected - map project -->
  <PathGeometry x:Key="Icon.Map" Figures="M3.4,4 L12.6,4 M3.4,8 L12.6,8 M3.4,12 L12.6,12 M1.6,4 L1.6,4.02 M1.6,8 L1.6,8.02 M1.6,12 L1.6,12.02" />

  <!-- checkmark - status / confirmation -->
  <PathGeometry x:Key="Icon.Check" Figures="M3,8.4 L6.4,11.8 L13,4.6" />

  <!-- chevron.down - combo box -->
  <PathGeometry x:Key="Icon.ChevronDown" Figures="M3.4,6.2 L8,10.4 L12.6,6.2" />

  <!-- chevron.up.chevron.down - macOS pop-up button -->
  <PathGeometry x:Key="Icon.ChevronUpDown" Figures="M4.4,6.6 L8,3.2 L11.6,6.6 M4.4,9.4 L8,12.8 L11.6,9.4" />

  <!-- xmark - traffic light / clear -->
  <PathGeometry x:Key="Icon.Close" Figures="M4,4 L12,12 M12,4 L4,12" />

  <!-- minus - traffic light -->
  <PathGeometry x:Key="Icon.Minus" Figures="M3.6,8 L12.4,8" />

  <!-- arrow.up.left.and.arrow.down.right - traffic light zoom -->
  <PathGeometry x:Key="Icon.Zoom" Figures="M3,3 L7,3 L3,7 Z M13,13 L9,13 L13,9 Z" />

  <!-- doc.on.doc - copy -->
  <PathGeometry x:Key="Icon.Copy" Figures="M5.6,5.6 L5.6,2.4 L13.6,2.4 L13.6,10.4 L10.4,10.4 M2.4,5.6 L10.4,5.6 L10.4,13.6 L2.4,13.6 Z" />

  <!-- trash - clear log -->
  <PathGeometry x:Key="Icon.Trash" Figures="M2.4,4.4 L13.6,4.4 M6,4.4 L6,2.4 L10,2.4 L10,4.4 M3.8,4.4 L4.6,13.6 L11.4,13.6 L12.2,4.4" />

  <!-- The one place the icon weight is set. -->
  <Style x:Key="Mac.Icon" TargetType="Path">
    <!-- TextElement.Foreground is inherited, so the glyph picks up whatever colour the
         surrounding button is currently painting its label in - including on hover. -->
    <Setter Property="Stroke" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
    <Setter Property="StrokeThickness" Value="1.35" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="StrokeLineJoin" Value="Round" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="SnapsToDevicePixels" Value="False" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

</ResourceDictionary>
