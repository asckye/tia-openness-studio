<!--
  Type ramp and metrics.

  Apple's own faces (SF Pro, SF Mono) are not licensed for redistribution and are not present on
  Windows, so each family is a fallback chain: WPF walks it per glyph, which means Latin text
  lands on the closest available humanist sans while CJK falls through to PingFang or YaHei
  rather than to a tofu box. The chain is deliberately ordered so a machine that *does* have SF
  Pro installed gets the real thing.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <FontFamily x:Key="Mac.Font">SF Pro Text, SF Pro Display, Segoe UI Variable Text, Segoe UI, PingFang SC, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
  <FontFamily x:Key="Mac.FontDisplay">SF Pro Display, SF Pro Text, Segoe UI Variable Display, Segoe UI, PingFang SC, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
  <FontFamily x:Key="Mac.FontMono">SF Mono, JetBrains Mono, Cascadia Mono, Consolas, Menlo, monospace</FontFamily>

  <sys:Double x:Key="Mac.FontSize.Caption">11</sys:Double>
  <sys:Double x:Key="Mac.FontSize.Small">12</sys:Double>
  <sys:Double x:Key="Mac.FontSize.Body">13</sys:Double>
  <sys:Double x:Key="Mac.FontSize.Title">13.5</sys:Double>
  <sys:Double x:Key="Mac.FontSize.Large">17</sys:Double>

  <CornerRadius x:Key="Mac.Radius.Control">6</CornerRadius>
  <CornerRadius x:Key="Mac.Radius.Field">6</CornerRadius>
  <CornerRadius x:Key="Mac.Radius.Card">10</CornerRadius>
  <CornerRadius x:Key="Mac.Radius.Pill">100</CornerRadius>

  <!-- The window title: centred, semibold, never competing with the content. -->
  <Style x:Key="Mac.Text.WindowTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Mac.FontDisplay}" />
    <Setter Property="FontSize" Value="{DynamicResource Mac.FontSize.Title}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Mac.Label}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="Mac.Text.Body" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Mac.Font}" />
    <Setter Property="FontSize" Value="{DynamicResource Mac.FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Mac.Label}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="Mac.Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Mac.Text.Body}">
    <Setter Property="Foreground" Value="{DynamicResource Mac.SecondaryLabel}" />
  </Style>

  <Style x:Key="Mac.Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Mac.Text.Secondary}">
    <Setter Property="FontSize" Value="{DynamicResource Mac.FontSize.Caption}" />
  </Style>

  <!-- Sidebar / pane headers. macOS sets these small, uppercase-ish and quiet. -->
  <Style x:Key="Mac.Text.SectionHeader" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Mac.Font}" />
    <Setter Property="FontSize" Value="{DynamicResource Mac.FontSize.Caption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Mac.TertiaryLabel}" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

  <!-- The label to the left of a field, right-aligned the way a macOS form aligns them. -->
  <Style x:Key="Mac.Text.FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Mac.Text.Secondary}">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>

</ResourceDictionary>
