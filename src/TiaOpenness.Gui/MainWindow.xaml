<Window x:Class="TiaOpenness.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:l="clr-namespace:TiaOpenness.Gui.Localization"
        xmlns:th="clr-namespace:TiaOpenness.Gui.Themes"
        xmlns:ux="clr-namespace:TiaOpenness.Gui.Controls"
        Style="{StaticResource Mac.Window}"
        Title="{l:Tr App.Title}"
        Height="860" Width="1280" MinHeight="560" MinWidth="960"
        WindowStartupLocation="CenterScreen">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="44" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ============================ title bar ============================ -->
    <!-- 44px, matching WindowChrome.CaptionHeight in the Mac.Window style. Everything clickable
         in here has to opt back out of the chrome, or the drag region eats the click. -->
    <Border Grid.Row="0" Background="{DynamicResource Mac.TitleBarBackground}"
            BorderBrush="{DynamicResource Mac.Separator}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="TrafficLights" Grid.Column="0" Orientation="Horizontal"
                    VerticalAlignment="Center" Margin="18,0,0,0">
          <Button Style="{StaticResource Mac.TrafficLight}"
                  Background="{StaticResource Mac.Light.Close}"
                  ux:Ux.Icon="{StaticResource Icon.Close}"
                  ToolTip="{l:Tr Chrome.Close}" Click="OnClose" />
          <Button Style="{StaticResource Mac.TrafficLight}"
                  Background="{StaticResource Mac.Light.Minimize}"
                  ux:Ux.Icon="{StaticResource Icon.Minus}"
                  ToolTip="{l:Tr Chrome.Minimize}" Click="OnMinimize" />
          <Button Style="{StaticResource Mac.TrafficLight}"
                  Background="{StaticResource Mac.Light.Zoom}"
                  ux:Ux.Icon="{StaticResource Icon.Zoom}"
                  ToolTip="{l:Tr Chrome.Zoom}" Click="OnZoom" />
        </StackPanel>

        <!-- macOS puts the document name in the title bar; the app name is on the menu bar it
             does not have here, so both go in, weighted. -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                    VerticalAlignment="Center">
          <TextBlock Text="{l:Tr App.Title}" Style="{StaticResource Mac.Text.WindowTitle}" />
          <TextBlock Text="{Binding ProjectName}" Style="{StaticResource Mac.Text.Secondary}"
                     Margin="8,0,0,0" MaxWidth="420" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                    Margin="0,0,14,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">

          <Border Style="{StaticResource Mac.SegmentBar}" ToolTip="{l:Tr Lang.Switch}">
            <StackPanel Orientation="Horizontal">
              <RadioButton Style="{StaticResource Mac.SegmentPick}" GroupName="Language"
                           Content="{l:Tr Lang.English}"
                           IsChecked="{Binding IsEnglish, Source={x:Static l:Loc.Current}, Mode=TwoWay}" />
              <RadioButton Style="{StaticResource Mac.SegmentPick}" GroupName="Language"
                           Content="{l:Tr Lang.Chinese}"
                           IsChecked="{Binding IsChinese, Source={x:Static l:Loc.Current}, Mode=TwoWay}" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Mac.SegmentBar}" Margin="8,0,0,0"
                  ToolTip="{l:Tr Theme.Switch}">
            <StackPanel Orientation="Horizontal">
              <RadioButton Style="{StaticResource Mac.SegmentPick}" GroupName="Appearance"
                           Content="{l:Tr Theme.Auto}"
                           IsChecked="{Binding IsAuto, Source={x:Static th:ThemeManager.Current}, Mode=TwoWay}" />
              <RadioButton Style="{StaticResource Mac.SegmentPick}" GroupName="Appearance"
                           Content="{l:Tr Theme.Light}"
                           IsChecked="{Binding IsLight, Source={x:Static th:ThemeManager.Current}, Mode=TwoWay}" />
              <RadioButton Style="{StaticResource Mac.SegmentPick}" GroupName="Appearance"
                           Content="{l:Tr Theme.Dark}"
                           IsChecked="{Binding IsDark, Source={x:Static th:ThemeManager.Current}, Mode=TwoWay}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============================ toolbar ============================ -->
    <Border Grid.Row="1" Background="{DynamicResource Mac.WindowBackground}"
            BorderBrush="{DynamicResource Mac.Separator}" BorderThickness="0,0,0,1"
            Padding="16,8,16,12">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource Mac.Button.Toolbar}" ux:Ux.Icon="{StaticResource Icon.Doctor}"
                  Content="{l:Tr Toolbar.Doctor}" ToolTip="{l:Tr Toolbar.Doctor.Tip}"
                  Command="{Binding RunDoctor}" />
          <Button Style="{StaticResource Mac.Button.Toolbar}" ux:Ux.Icon="{StaticResource Icon.Connect}"
                  Content="{l:Tr Toolbar.Connect}" ToolTip="{l:Tr Toolbar.Connect.Tip}"
                  Command="{Binding Connect}" />

          <Rectangle Style="{StaticResource Mac.ToolbarSeparator}" />

          <Button Style="{StaticResource Mac.Button.Toolbar}" ux:Ux.Icon="{StaticResource Icon.Compile}"
                  Content="{l:Tr Toolbar.Compile}" Command="{Binding Compile}" />
          <Button Style="{StaticResource Mac.Button.Toolbar}" ux:Ux.Icon="{StaticResource Icon.Inspect}"
                  Content="{l:Tr Toolbar.Inspect}" Command="{Binding Inspect}" />
          <Button Style="{StaticResource Mac.Button.Toolbar}" ux:Ux.Icon="{StaticResource Icon.Import}"
                  Content="{l:Tr Toolbar.Import}" Command="{Binding Import}" />
          <Button Style="{StaticResource Mac.Button.ToolbarDestructive}" ux:Ux.Icon="{StaticResource Icon.Save}"
                  Content="{l:Tr Toolbar.Save}" ToolTip="{l:Tr Toolbar.Save.Tip}"
                  Command="{Binding Save}" />

          <Rectangle Style="{StaticResource Mac.ToolbarSeparator}" />

          <CheckBox Content="{l:Tr Toolbar.Mock}" ToolTip="{l:Tr Toolbar.Mock.Tip}"
                    IsChecked="{Binding UseMock}" Margin="0,0,14,0" />
          <CheckBox Content="{l:Tr Toolbar.Headless}" ToolTip="{l:Tr Toolbar.Headless.Tip}"
                    IsChecked="{Binding Headless}" />
        </StackPanel>

        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{l:Tr Project.Label}" Style="{StaticResource Mac.Text.Secondary}"
                     Margin="0,0,10,0" />
          <TextBox Grid.Column="1" Text="{Binding ProjectPath, UpdateSourceTrigger=PropertyChanged}"
                   ux:Ux.Placeholder="{l:Tr Project.Placeholder}" />
          <Button Grid.Column="2" Content="{l:Tr Common.Browse}" ux:Ux.Icon="{StaticResource Icon.Folder}"
                  Click="OnBrowseProject" Margin="10,0,0,0" />
          <Button Grid.Column="3" Content="{l:Tr Common.Open}" Style="{StaticResource Mac.Button.Primary}"
                  Command="{Binding OpenProject}" Margin="0" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- ============================ body ============================ -->
    <Grid Grid.Row="2" Margin="16,14,16,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="248" MinWidth="180" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="*" MinWidth="420" />
      </Grid.ColumnDefinitions>

      <!-- ===== sidebar ===== -->
      <Border Grid.Column="0" Style="{StaticResource Mac.Card}"
              Background="{DynamicResource Mac.SidebarBackground}" Padding="10">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{l:Tr Sidebar.Devices}"
                     Style="{StaticResource Mac.Text.SectionHeader}" Margin="6,2,0,8" />

          <TextBlock DockPanel.Dock="Bottom" Text="{l:Tr Sidebar.Empty}"
                     Style="{StaticResource Mac.Text.Caption}" TextWrapping="Wrap" Margin="6,8,6,2"
                     Visibility="{Binding HasNoDevices, Converter={StaticResource BoolToVisibility}}" />

          <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Id}" FontWeight="Medium" />
                  <TextBlock FontSize="11" Opacity="0.75" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Category, Mode=OneWay}" />
                    <Run Text="·" />
                    <Run Text="{Binding ArticleNumber, Mode=OneWay}" />
                  </TextBlock>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch"
                    ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />

      <!-- ===== main pane ===== -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" MinHeight="240" />
          <RowDefinition Height="10" />
          <RowDefinition Height="196" MinHeight="90" />
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs" Grid.Row="0">

          <!-- ===== blocks ===== -->
          <TabItem Header="{l:Tr Tab.Blocks}">
            <Border Style="{StaticResource Mac.Card}" Padding="12">
              <DockPanel>

                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox Margin="0,0,12,0"
                           Text="{Binding BlockFilter, UpdateSourceTrigger=PropertyChanged}"
                           ux:Ux.Placeholder="{l:Tr Blocks.Filter}" />
                  <Button Grid.Column="1" Content="{l:Tr Common.All}" Click="OnSelectAll" MinWidth="54" />
                  <Button Grid.Column="2" Content="{l:Tr Common.None}" Click="OnSelectNone" MinWidth="54" />
                  <Button Grid.Column="3" Content="{l:Tr Common.Reload}" ux:Ux.Icon="{StaticResource Icon.Reload}"
                          Command="{Binding Refresh}" Margin="0" />
                </Grid>

                <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{l:Tr Blocks.ExportTo}" Style="{StaticResource Mac.Text.Secondary}"
                             Margin="0,0,10,0" />
                  <TextBox Grid.Column="1"
                           Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" />
                  <Button Grid.Column="2" Content="{l:Tr Common.Browse}" ux:Ux.Icon="{StaticResource Icon.Folder}"
                          Click="OnBrowseOutput" Margin="10,0,10,0" />
                  <CheckBox Grid.Column="3" Content="{l:Tr Blocks.SourceFormat}"
                            ToolTip="{l:Tr Blocks.SourceFormat.Tip}"
                            IsChecked="{Binding SourceFormat}" Margin="0,0,12,0" />
                  <Button Grid.Column="4" Content="{l:Tr Blocks.Export}" ux:Ux.Icon="{StaticResource Icon.Export}"
                          Style="{StaticResource Mac.Button.Primary}" Command="{Binding Export}" Margin="0" />
                </Grid>

                <TextBlock DockPanel.Dock="Bottom" Text="{Binding SelectionSummary}"
                           Style="{StaticResource Mac.Text.Caption}" Margin="2,10,0,0" />

                <DataGrid ItemsSource="{Binding BlocksView}" IsReadOnly="False">
                  <DataGrid.Columns>
                    <DataGridCheckBoxColumn Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}"
                                            Width="38">
                      <DataGridCheckBoxColumn.ElementStyle>
                        <Style TargetType="CheckBox" BasedOn="{StaticResource Mac.CheckBox}">
                          <Setter Property="HorizontalAlignment" Value="Center" />
                        </Style>
                      </DataGridCheckBoxColumn.ElementStyle>
                      <DataGridCheckBoxColumn.EditingElementStyle>
                        <Style TargetType="CheckBox" BasedOn="{StaticResource Mac.CheckBox}">
                          <Setter Property="HorizontalAlignment" Value="Center" />
                        </Style>
                      </DataGridCheckBoxColumn.EditingElementStyle>
                    </DataGridCheckBoxColumn>

                    <DataGridTextColumn Binding="{Binding Path}" Width="*" IsReadOnly="True">
                      <DataGridTextColumn.Header>
                        <TextBlock Text="{l:Tr Col.Path}" />
                      </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding Kind}" Width="96" IsReadOnly="True">
                      <DataGridTextColumn.Header>
                        <TextBlock Text="{l:Tr Col.Kind}" />
                      </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding Number}" Width="64" IsReadOnly="True">
                      <DataGridTextColumn.Header>
                        <TextBlock Text="{l:Tr Col.Number}" />
                      </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding Language}" Width="72" IsReadOnly="True">
                      <DataGridTextColumn.Header>
                        <TextBlock Text="{l:Tr Col.Language}" />
                      </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding Author}" Width="116" IsReadOnly="True">
                      <DataGridTextColumn.Header>
                        <TextBlock Text="{l:Tr Col.Author}" />
                      </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding Status}" Width="160" IsReadOnly="True">
                      <DataGridTextColumn.Header>
                        <TextBlock Text="{l:Tr Col.Status}" />
                      </DataGridTextColumn.Header>
                      <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{DynamicResource Mac.Orange}" />
                          <Style.Triggers>
                            <!-- On the blue selection fill an orange warning is unreadable, so a
                                 selected row hands the cell back the selection's own colour. -->
                            <DataTrigger Value="True"
                                         Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}">
                              <Setter Property="Foreground" Value="{DynamicResource Mac.SelectionText}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </Border>
          </TabItem>

          <!-- ===== version control ===== -->
          <TabItem Header="{l:Tr Tab.VersionControl}">
            <Border Style="{StaticResource Mac.Card}" Padding="12">
              <DockPanel>

                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{l:Tr Vc.Workspace}" Style="{StaticResource Mac.Text.Secondary}"
                             Margin="0,0,10,0" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding Workspaces}"
                            SelectedItem="{Binding SelectedWorkspace}" DisplayMemberPath="Name" />
                  <Button Grid.Column="2" Content="{l:Tr Common.Reload}" ux:Ux.Icon="{StaticResource Icon.Reload}"
                          Command="{Binding VcRefresh}" Margin="10,0,0,0" />
                </Grid>

                <!-- The empty-state sentence has to be translated, and TargetNullValue takes a
                     literal rather than a binding, so the fallback is resolved in the view model. -->
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Mac.Text.Caption}"
                           TextWrapping="Wrap" Margin="2,0,0,10"
                           Text="{Binding WorkspaceRootDisplay}" />

                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{l:Tr Vc.New}" Style="{StaticResource Mac.Text.Secondary}"
                             Margin="0,0,10,0" />
                  <TextBox Grid.Column="1"
                           Text="{Binding NewWorkspaceName, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Grid.Column="2" Text="{l:Tr Vc.In}" Style="{StaticResource Mac.Text.Secondary}"
                             Margin="10,0,10,0" />
                  <TextBox Grid.Column="3" ToolTip="{l:Tr Vc.Folder.Tip}"
                           Text="{Binding NewWorkspaceFolder, UpdateSourceTrigger=PropertyChanged}" />
                  <Button Grid.Column="4" Content="{l:Tr Common.Browse}" ux:Ux.Icon="{StaticResource Icon.Folder}"
                          Click="OnBrowseWorkspace" Margin="10,0,10,0" />
                  <Button Grid.Column="5" Content="{l:Tr Vc.Create}" Command="{Binding VcCreate}" Margin="0" />
                </Grid>

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                  <CheckBox Content="{l:Tr Vc.DryRun}" ToolTip="{l:Tr Vc.DryRun.Tip}"
                            IsChecked="{Binding VcDryRun}" Margin="0,0,16,0" />
                  <CheckBox Content="{l:Tr Vc.ShowAll}" IsChecked="{Binding VcShowAll}" />

                  <Rectangle Style="{StaticResource Mac.ToolbarSeparator}" />

                  <Button Content="{l:Tr Vc.Map}" ux:Ux.Icon="{StaticResource Icon.Map}"
                          ToolTip="{l:Tr Vc.Map.Tip}" Command="{Binding VcMap}" />
                  <Button Content="{l:Tr Vc.Status}" Command="{Binding VcStatus}" />
                  <Button Content="{l:Tr Vc.Push}" ux:Ux.Icon="{StaticResource Icon.Push}"
                          ToolTip="{l:Tr Vc.Push.Tip}" Command="{Binding VcPush}" />
                  <Button Content="{l:Tr Vc.Pull}" ux:Ux.Icon="{StaticResource Icon.Pull}"
                          ToolTip="{l:Tr Vc.Pull.Tip}" Style="{StaticResource Mac.Button.Destructive}"
                          Command="{Binding VcPull}" Margin="0" />
                </StackPanel>

                <DataGrid ItemsSource="{Binding VcStatusItems}" IsReadOnly="True">
                  <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding CompareState}" Width="180">
                      <DataGridTextColumn.Header>
                        <TextBlock Text="{l:Tr Col.State}" />
                      </DataGridTextColumn.Header>
                      <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{DynamicResource Mac.Orange}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding CompareState}" Value="Equal">
                              <Setter Property="Foreground" Value="{DynamicResource Mac.Green}" />
                            </DataTrigger>
                            <DataTrigger Value="True"
                                         Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}">
                              <Setter Property="Foreground" Value="{DynamicResource Mac.SelectionText}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding Name}" Width="*">
                      <DataGridTextColumn.Header>
                        <TextBlock Text="{l:Tr Col.Object}" />
                      </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding FileFormat}" Width="100">
                      <DataGridTextColumn.Header>
                        <TextBlock Text="{l:Tr Col.Format}" />
                      </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </Border>
          </TabItem>
        </TabControl>

        <GridSplitter Grid.Row="1" Height="10" HorizontalAlignment="Stretch"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />

        <!-- ===== log ===== -->
        <Border Grid.Row="2" Style="{StaticResource Mac.Card}" Padding="12,10">
          <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
              <TextBlock Text="{l:Tr Log.Title}" Style="{StaticResource Mac.Text.SectionHeader}"
                         Margin="2,0,0,0" VerticalAlignment="Center" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Mac.Button.Icon}" ux:Ux.Icon="{StaticResource Icon.Copy}"
                        ToolTip="{l:Tr Log.Copy}" Click="OnCopyLog" />
                <Button Style="{StaticResource Mac.Button.Icon}" ux:Ux.Icon="{StaticResource Icon.Trash}"
                        ToolTip="{l:Tr Log.Clear}" Click="OnClearLog" Margin="0" />
              </StackPanel>
            </Grid>

            <TextBox Style="{StaticResource Mac.TextBox.Console}"
                     Text="{Binding Log, Mode=OneWay}" IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap" TextChanged="OnLogChanged" />
          </DockPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- ============================ status bar ============================ -->
    <Border Grid.Row="3" Background="{DynamicResource Mac.TitleBarBackground}"
            BorderBrush="{DynamicResource Mac.Separator}" BorderThickness="0,1,0,0"
            Padding="16,7">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- The one always-visible read on session state: grey idle, amber working, green live. -->
        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,9,0">
          <Ellipse.Style>
            <Style TargetType="Ellipse">
              <Setter Property="Fill" Value="{DynamicResource Mac.TertiaryLabel}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                  <Setter Property="Fill" Value="{DynamicResource Mac.Green}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Busy}" Value="True">
                  <Setter Property="Fill" Value="{DynamicResource Mac.Orange}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>

        <TextBlock Grid.Column="1" Text="{Binding Status}" Style="{StaticResource Mac.Text.Secondary}"
                   TextTrimming="CharacterEllipsis" />

        <ProgressBar Grid.Column="2" Width="200" Margin="14,0,0,0"
                     Maximum="{Binding ProgressMax}" Value="{Binding ProgressValue, Mode=OneWay}"
                     Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
    </Border>
  </Grid>
</Window>
