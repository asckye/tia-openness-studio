<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>TiaOpenness.Bridge</RootNamespace>
    <AssemblyName>TiaOpenness.Bridge</AssemblyName>
    <!-- Siemens.Engineering.dll is x64-only; AnyCPU would fault at load time on some hosts. -->
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TiaOpenness.Core\TiaOpenness.Core.csproj" />
    <ProjectReference Include="..\TiaOpenness.Contracts\TiaOpenness.Contracts.csproj" />
  </ItemGroup>

  <!--
    The Openness adapter only compiles where lib\Siemens.Engineering.dll exists. It is
    referenced rather than project-referenced so a machine without TIA Portal still builds
    the whole solution. The bridge then refuses a real session with a message naming this file,
    rather than silently serving synthetic data.
  -->
  <ItemGroup Condition="'$(HasOpennessLib)' == 'true'">
    <ProjectReference Include="..\TiaOpenness.Openness\TiaOpenness.Openness.csproj" />
  </ItemGroup>
</Project>
